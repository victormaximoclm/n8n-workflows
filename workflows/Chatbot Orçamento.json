      "parameters": {
        "jsCode": "function rand(min, max) {\n  return Math.random() * (max - min) + min;\n}\nconst msg = $input.first().json.body.data.message.conversation\nconst len = msg.length;\nconst tPerChar = rand(0.12, 0.30);\nconst readDelay = rand(0.5, 2.0);\nconst jitter = rand(-1.0, 2.0);\nlet secs = len * tPerChar + readDelay + jitter;\nif (secs < 1) secs = 1;\nif (secs > 25) secs = 25;\nsecs = Math.round(secs * 10) / 10;\nreturn [{ wait_seconds: secs }];"
