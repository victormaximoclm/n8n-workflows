              "value": "={{\n  (() => {\n    const field = $json.custom_fields.find(f => f.id === \"07c1a02b-d58f-4b48-908e-c6e0ae0148a5\");\n    if (!field?.value || !field.type_config?.options) return \"\";\n    \n    // field.value é um array de IDs\n    return field.value\n      .map(val => field.type_config.options.find(opt => opt.id === val)?.label)\n      .filter(Boolean)\n      .join(\", \");      // junta em string separada por vírgula\n  })()\n}}",
