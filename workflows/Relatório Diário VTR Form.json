      "parameters": {
        "jsCode": "const aceitos = [\n  \"SIM\",\n  \"Acima de 100 libras\",\n  \"Acima de 50 libras\",\n  \"Todos PRESENTES\",\n  \"LACRADO\"\n];\n\nconst camposVerificar = [\n  \"LIXEIRA 1 + SACO INFECTANTE 10 + SACO COMUM 10\",\n  \"APARADEIRA 1 + PAPAGAIO 1 + CUBA\",\n  \"KIT SUTURA 1 + KIT PARTO 1\",\n  \"ASPIRADOR PORTÁTIL 1 + NEBULIZADOR PORTÁTIL 01\",\n  \"01 KIT SSVV (GLICOSÍMETRO 1 + ESTETOSCÓPIO ADULTO E INFANTIL 1 + TERMÔMETRO 1 + TENSIÔMETRO MANUAL E DIGITAL 1)\",\n  \"OXIGÊNIO GRANDE 01 (LITRAGEM CILINDRO DE DOIS METROS) + MANÔMETRO\",\n  \"OXIGÊNIO GRANDE 02 (LITRAGEM CILINDRO DE DOIS METROS) + MANÔMETRO\",\n  \"OXIGÊNIO PORTÁTIL (LITRAGEM CILINDRO DE TRANSPORTE) + MANÔMETRO\",\n  \"FLUXÔMETRO 2 + BICO DE SAÍDA FLUXOMETRO 2 + ASPIRADOR DA RÉGUA 1\",\n  \"FICHAS DE QRU (HAPVIDA, BEM CUIDAR E UNIMED AEROMÉDICO) + CANETA 1\",\n  \"DECLARAÇÃO DE ÓBITO (1 UNIDADE)\",\n  \"JELCOS 2 (24 + 22 + 20 + 18 + 16)\",\n  \"SCALP 2 (25 + 23 + 21)\",\n  \"TIRA DE GLICEMIA 10 + LANCETA 10\",\n  \"AGULHAS 5 (25X7 + 25X8 + 40X12) + TRANSOFIX 2 + POLIFIX 3\",\n  \"SERINGAS 2 (1ML + 3ML) + 3 (5ML + 10ML + 20ML) + 1 (60ML)\",\n  \"ESPARADRAPO 1 + EQUIPO MACROGOTAS 3 + TESOURA 1 + LANTERNA 1 + EQUIPO MICROGOTAS 1\",\n  \"LONA DE TRANSPORTE 1 + MANTA TÉRMICA 1\",\n  \"COLETOR DE SISTEMA FECHADO 1 + SVD (Nº18 E 16) 2 + SVA (Nº12) 2 + D.U 2 + SNG (Nº12) 1 + SNE (Nº12) 1 + COLETOR DE SISTEMA ABERTO 1 + LIDOCAÍNA 1 + CLOREXIDINA AQUOSA 1\",\n  \"S.F 0,9% 500ML 2 + S.G 5% 500ML 1 + RINGER LACTATO 500ML 2 + S.G 5% 250ML 2 + S.F 0,9% 100ML 3\",\n  \"ÁGUA DESTILADA 10ML 10 + GLICOSE 50% 10ML 10 + S.F 0,9% 10ML 10\",\n  \"PACOTE DE GAZE 6 + COMPRESSAS 2 + ATADURAS 6\",\n  \"MÁSCARAS 10 + LENÇÓIS DESCARTÁVEIS 10 + TOUCA 10 + LENÇOL AZUL 5\",\n  \"CAIXA DE LUVA (P 1 - M 1 - G 1)\",\n  \"LUVA ESTÉRIL (7,0 1 + 7,5 1 + 8,0 1)\",\n  \"DISPENSER ÁLCOOL GEL 1 + ALMOTOLIA ÁLCOOL 70% 1\",\n  \"CAPA DE CHUVA 4\",\n  \"KIT COVID 4 + ÓCULOS DE PROTEÇÃO 4\",\n  \"M.R ADULTO 2 + INFANTIL 2 + KIT MACRONEBULIZAÇÃO 1 + LÁTEX 2 + UMIDIFICADOR 2 + M.N ADULTO 1 E INFANTIL 1\",\n  \"CN ADULTO 2 + CN INFANTIL 2\",\n  \"SONDAS DE ASPIRAÇÃO TRAQUEAL (Nº6 2 + Nº8 2 + Nº10 2 + Nº12 2 + Nº14 2)\",\n  \"MOCHILA DE MEDICAÇÕES COM LACRE\",\n  \"MOCHILA VIA AÉREA\",\n  \"MOCHILA DE TRAUMA\",\n  \"CABO DE FORÇA\",\n  \"CABOS DE MONITORIZAÇÃO CARDÍACA + ELETRODOS (ADUL E PED) + OXIMETRIA DE PULSO (ADULTO/PED/NEO) + CABO DE PNI (ADULTO/PED/NEO) + MANGUEIRA VENTILADOR + VÁLVULA DE PRESSÃO\",\n  \"CARDIOVERSOR 1\",\n  \"VENTILADOR DE TRANSPORTE COM FONTE 1\",\n  \"CIRCUITO VENTILADOR ADULTO 1 + PED 1 + NEO 1\",\n  \"BOMBA DE INFUSÃO COM FONTE 3\",\n  \"EQUIPO BOMBA PADRÃO E FOTO 3\",\n  \"LIMPEZA CONCORRENTE (EQUIPAMENTOS E BANCADAS)\"\n];\n\nconst DEBUG = false;\n\nconst normalizeKey = str => {\n  if (str === undefined || str === null) return \"\";\n  let s = String(str);\n  s = s.replace(/[\\u200B-\\u200D\\uFEFF]/g, \"\");\n  if (s.normalize) s = s.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n  s = s.replace(/[^A-Za-z0-9]+/g, \" \");\n  return s.trim().replace(/\\s+/g, \" \").toUpperCase();\n};\n\nconst aceitosNorm = aceitos.map(normalizeKey);\n\nreturn items.map(item => {\n  const data = item.json;\n  const foraDoPadrao = [];\n\n  for (const campo of camposVerificar) {\n    const campoNorm = normalizeKey(campo);\n    let entradaEncontrada = null;\n    for (const [chave, valor] of Object.entries(data)) {\n      if (normalizeKey(chave) === campoNorm) {\n        entradaEncontrada = { chave, valor };\n        break;\n      }\n    }\n    const valorStr = entradaEncontrada && entradaEncontrada.valor !== undefined && entradaEncontrada.valor !== null\n      ? String(entradaEncontrada.valor).trim() : \"\";\n    const valorNorm = normalizeKey(valorStr);\n    if (valorStr && !aceitosNorm.includes(valorNorm)) {\n      foraDoPadrao.push(campo);\n    }\n  }\n\n  return {\n    json: {\n      ...data,\n      resultado: foraDoPadrao.length === 0 ? \"Aprovado\" : \"Reprovado\",\n      campos_fora_do_padrao: foraDoPadrao\n    }\n  };\n});\n"
      },
