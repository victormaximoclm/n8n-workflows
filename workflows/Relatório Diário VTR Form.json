    {
      "parameters": {
        "jsCode": "const vtrs = items.flatMap(item => item.json);\n\nfunction getNumero(vtr) {\n  if (!vtr || typeof vtr !== \"string\") return null;\n  const match = vtr.match(/\\d+/);\n  return match ? parseInt(match[0], 10) : null;\n}\n\nconst grupos = {};\n\nvtrs.forEach(item => {\n  if (!item.VTR) return;\n  const numero = getNumero(item.VTR);\n  if (!numero) return;\n\n  if (!grupos[numero]) {\n    grupos[numero] = {\n      numero,\n      VTRs: [],\n      condutores: [],\n      enfermeiros: [],\n      pendencias_vtr: [],\n      pendencias_usa_usb: [],\n      fora_do_padrao_vtr: [],\n      fora_do_padrao_usa_usb: []\n    };\n  }\n\n  grupos[numero].VTRs.push(item.VTR);\n\n  if (item.condutor) grupos[numero].condutores.push(item.condutor);\n  if (item.enfermeiro) grupos[numero].enfermeiros.push(item.enfermeiro);\n\n  if (item.pendencias && item.pendencias.length > 0) {\n    if (item.condutor) {\n      grupos[numero].pendencias_vtr.push(...[].concat(item.pendencias));\n    } else if (item.enfermeiro) {\n      grupos[numero].pendencias_usa_usb.push(...[].concat(item.pendencias));\n    }\n  }\n\n  if (item.fora_do_padrao && item.fora_do_padrao.length > 0) {\n    if (item.VTR.startsWith(\"VTR\")) {\n      item.fora_do_padrao.forEach(fp => {\n        grupos[numero].fora_do_padrao_usa_usb.push({ ...fp, origem: \"USA/USB\" });\n      });\n    } else if (item.VTR.startsWith(\"USA\") || item.VTR.startsWith(\"USB\")) {\n      item.fora_do_padrao.forEach(fp => {\n        grupos[numero].fora_do_padrao_vtr.push({ ...fp, origem: \"VTR\" });\n      });\n    }\n  }\n});\n\nconst resultado = Object.values(grupos).map(grp => {\n  const hasUSA = grp.VTRs.some(v => v.startsWith(\"USA\") || v.startsWith(\"USB\"));\n  const hasVTR = grp.VTRs.some(v => v.startsWith(\"VTR\"));\n  grp.incompleto = !(hasUSA && hasVTR);\n  return grp;\n});\n\nresultado.forEach(grp => {\n  const vtrsCount = grp.VTRs.filter(v => v.startsWith(\"VTR\")).length;\n  const usaUsbCount = grp.VTRs.filter(v => v.startsWith(\"USA\") || v.startsWith(\"USB\")).length;\n  grp.possui_excesso = (vtrsCount > 1 || usaUsbCount > 1);\n  grp.excesso_tipo = null;\n  if (vtrsCount > 1 && usaUsbCount > 1) grp.excesso_tipo = \"Múltiplos VTRs e múltiplos USA/USB\";\n  else if (vtrsCount > 1) grp.excesso_tipo = \"Mais de um checklist USA/USB\";\n  else if (usaUsbCount > 1) grp.excesso_tipo = \"Mais de um checklist VTR\";\n});\n\nreturn resultado.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [192, -288],
      "id": "9816b894-1b47-49e4-8a9e-f29469fcc495",
      "name": "Junta e Mescla",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const formatarVTRs = (lista) => lista.map(nome => nome.replace(/^(VTR|USA|USB)/i, \"\").trim());\n\nconst vtrsArray = items.flatMap(item => item.json).filter(v => Object.keys(v).length > 0);\n\nif (vtrsArray.length === 0) {\n  return [{ json: { mensagens: [\"Nenhum checklist foi preenchido até agora.\"], mensagemFinal: \"🚨*Atenção🚨:*\\\\n\\\\nNenhum checklist foi preenchido até agora.\" } }];\n}\n\nconst contadorVTR = {};\nconst contadorUSA = {};\n\nvtrsArray.forEach(vtr => {\n  const nomes = vtr.VTRs || [];\n  nomes.forEach(n => {\n    if (/^VTR/i.test(n)) { contadorVTR[n] = (contadorVTR[n] || 0) + 1; }\n    else if (/^(USA|USB)/i.test(n)) { contadorUSA[n] = (contadorUSA[n] || 0) + 1; }\n  });\n});\n\nconst vtrDuplicada = Object.values(contadorVTR).some(v => v > 1);\nconst usaDuplicada = Object.values(contadorUSA).some(v => v > 1);\n\nconst vtrUnicas = [...new Set(vtrsArray.filter(v => (v.condutores && v.condutores.length > 0) || (v.enfermeiros && v.enfermeiros.length > 0)).flatMap(v => formatarVTRs(v.VTRs || [])))];\nconst totalPreenchidas = vtrUnicas.length;\n\nconst mensagens = vtrsArray.map(vtr => {\n  const vtrNomes = [...new Set(formatarVTRs(vtr.VTRs))];\n  let msg = `🚑 *VTR:* ${vtrNomes.join(\", VTR \")}`;\n\n  const hasEnfermeiro = vtr.enfermeiros && vtr.enfermeiros.length > 0;\n  const hasCondutor = vtr.condutores && vtr.condutores.length > 0;\n\n  msg += `\\\\n\\\\n🛠️ *Checklist VTR${hasCondutor ? ` (Condutor: ${vtr.condutores.join(\", \")})` : \"\"}*`;\n  if (!hasCondutor) {\n    msg += `\\\\n⚠️ Não respondido`;\n  } else {\n    const foraVTR = vtr.fora_do_padrao_vtr || [];\n    if (foraVTR.length > 0) {\n      msg += `\\\\n🔎 ${foraVTR.length} item(s) fora do padrão:`;\n      msg += foraVTR.map(f => `\\\\n• ${f.campo}: ${f.valor}`).join(\"\");\n    } else {\n      msg += `\\\\n✅ Dentro do padrão`;\n    }\n    if (vtr.pendencias_vtr && vtr.pendencias_vtr.length > 0) {\n      const limpas = vtr.pendencias_vtr.map(p => p.replace(/\\n/g, \" \").trim());\n      msg += `\\\\n📌 Observações: ${limpas.join(\", \")}`;\n    }\n  }\n\n  msg += `\\\\n\\\\n🏥 *Checklist USA/USB${hasEnfermeiro ? ` (Enfermeiro(a): ${vtr.enfermeiros.join(\", \")})` : \"\"}*`;\n  if (!hasEnfermeiro) {\n    msg += `\\\\n⚠️ Não respondido`;\n  } else {\n    const foraUSA = vtr.fora_do_padrao_usa_usb || [];\n    if (foraUSA.length > 0) {\n      msg += `\\\\n🔎 ${foraUSA.length} item(s) fora do padrão:`;\n      msg += foraUSA.map(f => `\\\\n• ${f.campo}: ${f.valor}`).join(\"\");\n    } else {\n      msg += `\\\\n✅ Dentro do padrão`;\n    }\n    if (vtr.pendencias_usa_usb && vtr.pendencias_usa_usb.length > 0) {\n      const limpas = vtr.pendencias_usa_usb.map(p => p.replace(/\\n/g, \" \").trim());\n      msg += `\\\\n📌 Observações: ${limpas.join(\", \")}`;\n    }\n  }\n\n  return msg.trim();\n});\n\nif (totalPreenchidas === 0) {\n  return [{ json: { mensagens: [\"Nenhum checklist foi preenchido até agora.\"], mensagemFinal: \"*🚨Atenção🚨:*\\\\n\\\\nNenhum checklist foi preenchido até agora.\" } }];\n}\n\nlet cabecalho = totalPreenchidas === 1 ? `📋 *Apenas 1 VTR preencheu o checklist.*\\\\n\\\\n` : `📋 *${totalPreenchidas} VTRs preencheram o checklist.*\\\\n\\\\n`;\nlet alertas = \"\";\nif (vtrDuplicada) alertas += \"\\\\n🚨 *Alerta:* VTR preenchida duas vezes!\";\nif (usaDuplicada) alertas += \"\\\\n🚨 *Alerta:* USA/USB preenchido duas vezes!\";\n\nconst mensagemFinal = cabecalho + mensagens.join(\"\\\\n\\\\n---\\\\n\\\\n\") + (alertas ? `\\\\n\\\\n${alertas}` : \"\");\n\nreturn [{ json: { mensagens, mensagemFinal } }];"
      },
